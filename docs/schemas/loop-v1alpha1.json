{
  "$ref": "#/definitions/LoopSpec",
  "definitions": {
    "LoopSpec": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "loopgraph/v1alpha1"
        },
        "kind": {
          "type": "string",
          "const": "Loop"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "owner": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "webhook",
                "schedule",
                "manual",
                "event"
              ]
            },
            "source": {
              "type": "string"
            },
            "event": {
              "type": "string"
            },
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "source",
            "event"
          ],
          "additionalProperties": false
        },
        "input": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "object",
              "additionalProperties": {}
            },
            "fixtures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "path"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "schema"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/definitions/LoopSpec/properties/input/properties/schema"
            }
          },
          "required": [
            "schema"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "policy",
                      "fixture",
                      "integration",
                      "memory",
                      "event",
                      "trace"
                    ]
                  },
                  "adapterId": {
                    "type": "string"
                  },
                  "variableKey": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "sensitivity": {
                    "type": "string",
                    "enum": [
                      "public",
                      "internal",
                      "confidential",
                      "restricted"
                    ],
                    "default": "internal"
                  },
                  "trusted": {
                    "type": "boolean",
                    "default": true
                  },
                  "precedence": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "type",
                  "title",
                  "precedence"
                ],
                "additionalProperties": false
              }
            },
            "precedence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sourceType": {
                    "type": "string",
                    "enum": [
                      "policy",
                      "fixture",
                      "integration",
                      "memory",
                      "event",
                      "trace"
                    ]
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "sourceType",
                  "rank"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "tokenBudget": {
              "type": "number"
            },
            "redactionPolicy": {
              "type": "string",
              "enum": [
                "none",
                "restricted_only",
                "aggressive"
              ],
              "default": "restricted_only"
            }
          },
          "required": [
            "sources"
          ],
          "additionalProperties": false
        },
        "routine": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "stepType": {
                    "type": "string"
                  },
                  "actor": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "human",
                      "system"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "stepType",
                  "actor",
                  "description"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "steps"
          ],
          "additionalProperties": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "adapterId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "writeCapable": {
                "type": "boolean",
                "default": false
              },
              "inputSchema": {
                "$ref": "#/definitions/LoopSpec/properties/input/properties/schema"
              },
              "riskLevel": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ],
                "default": "low"
              }
            },
            "required": [
              "key",
              "adapterId",
              "label"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "policy": {
          "type": "object",
          "properties": {
            "allowedActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "toolKey": {
                    "type": "string"
                  },
                  "allowed": {
                    "type": "boolean",
                    "default": true
                  },
                  "requiresApproval": {
                    "type": "boolean",
                    "default": false
                  },
                  "customerFacing": {
                    "type": "boolean",
                    "default": false
                  },
                  "riskLevel": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ],
                    "default": "low"
                  }
                },
                "required": [
                  "toolKey"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "forbiddenActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "toolKey": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "toolKey",
                  "reason"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "escalationRules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "when": {
                    "type": "object",
                    "additionalProperties": {}
                  },
                  "createEscalationCase": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string"
                      },
                      "severity": {
                        "type": "string",
                        "enum": [
                          "P0",
                          "P1",
                          "P2",
                          "P3"
                        ]
                      }
                    },
                    "required": [
                      "category"
                    ],
                    "additionalProperties": false
                  },
                  "routeTo": {
                    "type": "object",
                    "properties": {
                      "primaryOwner": {
                        "type": "string"
                      },
                      "reviewers": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "default": []
                      },
                      "responseSla": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "primaryOwner"
                    ],
                    "additionalProperties": false
                  },
                  "requiresApproval": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "decisionsRequired": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  }
                },
                "required": [
                  "id",
                  "when",
                  "routeTo"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "riskLimits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": [
                  "key",
                  "max"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "schema",
                  "policy",
                  "evidence",
                  "numeric_threshold",
                  "approval_required",
                  "mock_judge"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "id",
              "type"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "approval": {
          "type": "object",
          "properties": {
            "requireFingerprintMatch": {
              "type": "boolean",
              "default": true
            },
            "separateCustomerFacingApproval": {
              "type": "boolean",
              "default": true
            },
            "allowedRoles": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "approver",
                  "reviewer",
                  "owner",
                  "teacher",
                  "executor",
                  "accountability_holder"
                ]
              },
              "default": [
                "approver"
              ]
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "idempotency": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false
            },
            "timeout": {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number"
                }
              },
              "required": [
                "seconds"
              ],
              "additionalProperties": false
            },
            "retry": {
              "type": "object",
              "properties": {
                "maxAttempts": {
                  "type": "number"
                }
              },
              "required": [
                "maxAttempts"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "idempotency"
          ],
          "additionalProperties": false,
          "default": {
            "idempotency": {
              "enabled": true
            }
          }
        },
        "trace": {
          "type": "object",
          "properties": {
            "captureContextSnapshot": {
              "type": "boolean",
              "default": true
            },
            "captureToolInputOutput": {
              "type": "boolean",
              "default": true
            },
            "evidenceRequired": {
              "type": "boolean",
              "default": true
            },
            "exportOpenTelemetry": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "topology": {
          "type": "object",
          "properties": {
            "parentLoopId": {
              "type": "string"
            },
            "department": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "studioExtension": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "trigger",
        "input",
        "output",
        "context",
        "routine",
        "policy",
        "approval",
        "trace"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}