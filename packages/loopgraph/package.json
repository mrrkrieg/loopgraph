{
  "name": "loopgraph",
  "version": "0.2.0",
  "description": "Code-first loop runtime: validate, simulate, trace, review, and case resolve from loopgraph.yaml specs.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "loopgraph": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "openai": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "esbuild": "^0.28.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6",
    "yaml": "^2.9.0",
    "zod": "^3.25.67"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
