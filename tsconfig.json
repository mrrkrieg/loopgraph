{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "loopgraph/core": [
        "./packages/loopgraph/src/core/index.ts"
      ],
      "loopgraph/runtime": [
        "./packages/loopgraph/src/runtime/index.ts"
      ],
      "loopgraph/sdk": [
        "./packages/loopgraph/src/sdk/index.ts"
      ],
      "@/lib/loopgraph-core/*": [
        "./packages/loopgraph/src/core/*"
      ],
      "@/lib/loopgraph-runtime/storage-resolver": [
        "./lib/loopgraph-runtime/storage-resolver.ts"
      ],
      "@/lib/loopgraph-runtime/*": [
        "./packages/loopgraph/src/runtime/*"
      ],
      "@/lib/loopgraph-sdk/*": [
        "./packages/loopgraph/src/sdk/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "packages/loopgraph/tsup.config.ts"
  ]
}
