{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "loopgraph/core": [
        "./packages/loopgraph/src/core/index.ts"
      ],
      "loopgraph/runtime": [
        "./packages/loopgraph/src/runtime/index.ts"
      ],
      "loopgraph/sdk": [
        "./packages/loopgraph/src/sdk/index.ts"
      ],
      "@/lib/loopgraph-core/*": [
        "./packages/loopgraph/src/core/*"
      ],
      "@/lib/loopgraph-runtime/storage-resolver": [
        "./lib/loopgraph-runtime/storage-resolver.ts"
      ],
      "@/lib/loopgraph-runtime/discovery-engine": [
        "./lib/loopgraph-runtime/discovery-engine.ts"
      ],
      "@/lib/loopgraph-runtime/skill-pack-loader": [
        "./lib/loopgraph-runtime/skill-pack-loader.ts"
      ],
      "@/lib/loopgraph-runtime/access-planner": [
        "./lib/loopgraph-runtime/access-planner.ts"
      ],
      "@/lib/loopgraph-runtime/daily-summary-generator": [
        "./lib/loopgraph-runtime/daily-summary-generator.ts"
      ],
      "@/lib/loopgraph-runtime/human-requirement-planner": [
        "./lib/loopgraph-runtime/human-requirement-planner.ts"
      ],
      "@/lib/loopgraph-runtime/loop-readiness": [
        "./lib/loopgraph-runtime/loop-readiness.ts"
      ],
      "@/lib/loopgraph-runtime/loop-materializer": [
        "./lib/loopgraph-runtime/loop-materializer.ts"
      ],
      "@/lib/loopgraph-runtime/loop-recommender": [
        "./lib/loopgraph-runtime/loop-recommender.ts"
      ],
      "@/lib/loopgraph-runtime/operating-view-data": [
        "./lib/loopgraph-runtime/operating-view-data.ts"
      ],
      "@/lib/loopgraph-runtime/agent-operations-view-data": [
        "./lib/loopgraph-runtime/agent-operations-view-data.ts"
      ],
      "@/lib/loopgraph-runtime/worker-api-auth": [
        "./lib/loopgraph-runtime/worker-api-auth.ts"
      ],
      "@/lib/loopgraph-runtime/hosted-hermes-route-authority": [
        "./lib/loopgraph-runtime/hosted-hermes-route-authority.ts"
      ],
      "@/lib/loopgraph-runtime/metric-planner": [
        "./lib/loopgraph-runtime/metric-planner.ts"
      ],
      "@/lib/loopgraph-runtime/process-classifier": [
        "./lib/loopgraph-runtime/process-classifier.ts"
      ],
      "@/lib/loopgraph-runtime/undefined-metrics": [
        "./lib/loopgraph-runtime/undefined-metrics.ts"
      ],
      "@/lib/loopgraph-runtime/*": [
        "./packages/loopgraph/src/runtime/*"
      ],
      "@/lib/loopgraph-sdk/*": [
        "./packages/loopgraph/src/sdk/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "packages/loopgraph/tsup.config.ts"
  ]
}
