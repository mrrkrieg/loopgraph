NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only for an authenticated hosted deployment. The public demo remains read-only.
LOOPGRAPH_HOSTED_MODE=
# Required when the service-role runtime adapter is enabled. Scopes worker data to one tenant.
LOOPGRAPH_HOSTED_ORGANIZATION_ID=
# Required for hosted caches and remaining file-backed runtime state. Detached App snapshots use
# the private loopgraph-app-snapshots Supabase Storage bucket and do not depend on this volume.
# Use a persistent volume, never the repository root.
LOOPGRAPH_HOSTED_RUNTIME_ROOT=
# Optional namespace below the organization. Defaults to "default".
LOOPGRAPH_HOSTED_PROJECT_KEY=
# Set only for the public sample deployment; never combine with private customer data.
LOOPGRAPH_PREVIEW_CONTENT=
OPENAI_API_KEY=
LOOPGRAPH_OPENAI_MODEL=gpt-4.1-mini
LOOPGRAPH_ASSESSMENT_PROVIDER=fixture
LOOPGRAPH_EXECUTE_ENABLED=false
LOOPGRAPH_PUBLIC_URL=
# HMAC key for privacy-preserving device-code issuance throttling (32+ random characters).
LOOPGRAPH_DEVICE_AUTH_FINGERPRINT_SECRET=
# Set only when a trusted self-hosted ingress strips and rewrites X-Forwarded-For.
LOOPGRAPH_TRUSTED_PROXY_HEADERS=false
LOOPGRAPH_HERMES_WEBHOOK_URL=
LOOPGRAPH_HERMES_WEBHOOK_SECRET=
LOOPGRAPH_HERMES_CALLBACK_SECRET=
LOOPGRAPH_HERMES_CALLBACK_CREDENTIAL_ID=
LOOPGRAPH_HERMES_CALLBACK_RATE_LIMIT_PER_MINUTE=60
# Live loop assignments are sent to Hermes; Loopgraph never stores provider credentials.
LOOPGRAPH_HERMES_EXECUTION_URL=
LOOPGRAPH_HERMES_EXECUTION_SECRET=
# Use a separate inbound secret when possible. Falls back to EXECUTION_SECRET locally.
LOOPGRAPH_HERMES_EXECUTION_CALLBACK_SECRET=
LOOPGRAPH_HERMES_EXECUTION_ENVIRONMENT=sandbox
LOOPGRAPH_HERMES_EXECUTION_CREDENTIAL_ID=
LOOPGRAPH_HERMES_EXECUTION_RATE_LIMIT_PER_MINUTE=600
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=
LOOPGRAPH_GITHUB_WEBHOOK_CREDENTIAL_ID=
LOOPGRAPH_GITHUB_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
CRON_SECRET=
LOOPGRAPH_CRON_CREDENTIAL_ID=
LOOPGRAPH_CRON_RATE_LIMIT_PER_MINUTE=20
LOOPGRAPH_WORKER_API_TOKEN=
LOOPGRAPH_WORKER_CREDENTIAL_ID=
LOOPGRAPH_WORKER_RATE_LIMIT_PER_MINUTE=120
# Production machine APIs use signed workload identity. This JSON contains public issuer/JWKS
# metadata and policy only; it contains no token or private key.
LOOPGRAPH_WORKLOAD_IDENTITY_ISSUERS=
# Optional projected JWT minted specifically for LOOPGRAPH_CONNECTOR_BROKER_AUDIENCE.
LOOPGRAPH_WORKLOAD_IDENTITY_TOKEN_FILE=
# Connector workloads must also have an active durable principal and capability grant.
LOOPGRAPH_REQUIRE_DURABLE_WORKLOAD_GRANTS=true
# Enable only behind an origin-isolated gateway that verifies client mTLS certificates, strips
# caller-supplied x-loopgraph-mtls-* headers, and inserts the verified certificate SHA-256.
LOOPGRAPH_TRUSTED_MTLS_PROXY=false
LOOPGRAPH_DEPLOYMENT_ENVIRONMENT=production
# Temporary compatibility switch for production migrations only. Leave false for new deployments.
LOOPGRAPH_ALLOW_LEGACY_MACHINE_TOKENS=false
LOOPGRAPH_OBSERVABILITY_API_TOKEN=
LOOPGRAPH_OBSERVABILITY_CREDENTIAL_ID=
LOOPGRAPH_OBSERVABILITY_RATE_LIMIT_PER_MINUTE=60
# Hosted readiness fails closed when either reviewed recovery threshold is invalid.
LOOPGRAPH_APP_LIFECYCLE_RECOVERY_STALE_SECONDS=900
LOOPGRAPH_APP_ACTION_RECONCILIATION_STALE_SECONDS=300

# Private hosted marketplace for Hermes MCP and managed CLI runners. The server validates
# marketplace.consume in the workload JWT and in the durable workload grant table.
LOOPGRAPH_MARKETPLACE_URL=
LOOPGRAPH_MARKETPLACE_AUDIENCE=
LOOPGRAPH_MARKETPLACE_ORGANIZATION_ID=
LOOPGRAPH_MARKETPLACE_PROJECT_KEY=
LOOPGRAPH_MARKETPLACE_RATE_LIMIT_PER_MINUTE=120
# Development/migration compatibility only; production should use workload identity.
LOOPGRAPH_MARKETPLACE_API_TOKEN=
LOOPGRAPH_MARKETPLACE_CREDENTIAL_ID=
# Optional CLI-side absolute path. Defaults to the current user's config directory.
LOOPGRAPH_CLI_CREDENTIALS_FILE=

# Protected marketplace staging gate. Values ending in _FILE are absolute paths
# to short-lived projected workload JWTs on an isolated runner, never token text.
LOOPGRAPH_STAGING_URL=
LOOPGRAPH_STAGING_ORGANIZATION_ID=
LOOPGRAPH_STAGING_PROJECT_KEY=default
LOOPGRAPH_STAGING_OBSERVABILITY_TOKEN_FILE=
# Short-lived Supabase sessions are JSON files containing only access_token and refresh_token.
# Project all three into the isolated staging runner as private 0600 regular files.
LOOPGRAPH_STAGING_SUPABASE_URL=
LOOPGRAPH_STAGING_SUPABASE_PUBLISHABLE_KEY=
LOOPGRAPH_STAGING_ALLOWED_USER_SESSION_FILE=
LOOPGRAPH_STAGING_FOREIGN_USER_SESSION_FILE=
LOOPGRAPH_STAGING_SUSPENDED_USER_SESSION_FILE=
# Set a staging-only durable admin-bucket override (recommended: 3 requests / 1 second).
LOOPGRAPH_STAGING_USER_API_ADMIN_QUOTA_LIMIT=3
LOOPGRAPH_STAGING_USER_API_QUOTA_MAX_WAIT_SECONDS=5
LOOPGRAPH_STAGING_MARKETPLACE_URL=
LOOPGRAPH_STAGING_MARKETPLACE_AUDIENCE=
LOOPGRAPH_STAGING_MARKETPLACE_ORGANIZATION_ID=
LOOPGRAPH_STAGING_MARKETPLACE_PROJECT_KEY=default
LOOPGRAPH_STAGING_MARKETPLACE_APP_ID=
LOOPGRAPH_STAGING_MARKETPLACE_APP_VERSION=
LOOPGRAPH_STAGING_MARKETPLACE_ARTIFACT_DIGEST=
LOOPGRAPH_STAGING_MARKETPLACE_ALLOWED_TOKEN_FILE=
LOOPGRAPH_STAGING_MARKETPLACE_FOREIGN_TOKEN_FILE=
LOOPGRAPH_STAGING_MARKETPLACE_REVOKED_TOKEN_FILE=

# Enterprise Hermes Connector Broker. Loopgraph calls this URL with ambient workload identity.
LOOPGRAPH_CONNECTOR_BROKER_URL=
LOOPGRAPH_CONNECTOR_BROKER_AUDIENCE=
LOOPGRAPH_APP_URL=
# aws | gcp | azure | vault | keychain (local only) | env-ref (development only)
LOOPGRAPH_CONNECTOR_VAULT_PROVIDER=
# Temporary AWS migration escape hatch only; prefer IRSA/ECS/EC2/Lambda workload roles.
LOOPGRAPH_ALLOW_STATIC_AWS_CREDENTIALS=false
# Must contain {namespace} or {namespaceHash}; provider tokens are written here by the broker.
LOOPGRAPH_CONNECTOR_CREDENTIAL_TEMPLATE=
# JSON array of OAuth client IDs, callback URLs, auth methods, and opaque clientSecretRef values.
LOOPGRAPH_OAUTH_CLIENTS_JSON=
# Broker receipt-signing key is loaded from the configured vault, never entered in the browser.
LOOPGRAPH_WEBHOOK_RECEIPT_SIGNING_KEY_REF=
LOOPGRAPH_WEBHOOK_RECEIPT_KEY_ID=connector-broker-primary
# Separately versioned key for signed capability manifests exposed to Hermes.
LOOPGRAPH_CONNECTOR_MANIFEST_SIGNING_KEY_REF=
LOOPGRAPH_CONNECTOR_MANIFEST_SIGNING_KEY_ID=connector-manifest-primary
LOOPGRAPH_CONNECTOR_PLATFORM_SECRET_NAMESPACE=
HERMES_WEBHOOK_URL=
LOOPGRAPH_HERMES_WEBHOOK_AUDIENCE=
# HashiCorp Vault workload-JWT login configuration when the vault provider is "vault".
LOOPGRAPH_HASHICORP_VAULT_URL=
LOOPGRAPH_HASHICORP_VAULT_ROLE=
LOOPGRAPH_HASHICORP_VAULT_AUTH_MOUNT=jwt
