NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only for an authenticated hosted deployment. The public demo remains read-only.
LOOPGRAPH_HOSTED_MODE=
# Required when the service-role runtime adapter is enabled. Scopes worker data to one tenant.
LOOPGRAPH_HOSTED_ORGANIZATION_ID=
# Required for hosted file-backed runtime state. Use a persistent volume, never the repository root.
LOOPGRAPH_HOSTED_RUNTIME_ROOT=
# Optional namespace below the organization. Defaults to "default".
LOOPGRAPH_HOSTED_PROJECT_KEY=
# Set only for the public sample deployment; never combine with private customer data.
LOOPGRAPH_PREVIEW_CONTENT=
OPENAI_API_KEY=
LOOPGRAPH_OPENAI_MODEL=gpt-4.1-mini
LOOPGRAPH_ASSESSMENT_PROVIDER=fixture
LOOPGRAPH_EXECUTE_ENABLED=false
LOOPGRAPH_PUBLIC_URL=
LOOPGRAPH_HERMES_WEBHOOK_URL=
LOOPGRAPH_HERMES_WEBHOOK_SECRET=
LOOPGRAPH_HERMES_CALLBACK_SECRET=
LOOPGRAPH_HERMES_CALLBACK_CREDENTIAL_ID=
LOOPGRAPH_HERMES_CALLBACK_RATE_LIMIT_PER_MINUTE=60
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=
LOOPGRAPH_GITHUB_WEBHOOK_CREDENTIAL_ID=
LOOPGRAPH_GITHUB_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
CRON_SECRET=
LOOPGRAPH_CRON_CREDENTIAL_ID=
LOOPGRAPH_CRON_RATE_LIMIT_PER_MINUTE=20
